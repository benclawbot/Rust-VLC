import { ListView, Palette, ScrollView } from "std-widgets.slint";
import "../assets/fonts/Inter.ttf";

export struct TrackRow {
    id: int,
    index: int,
    playlist-position: int,
    title: string,
    detail: string,
    genre: string,
    duration: string,
    selected: bool,
    unavailable: bool,
    local-media: bool,
    artwork: image,
    has-artwork: bool,
    monogram: string,
    can-resume: bool,
    progress-label: string,
}

export struct BrowseRow {
    id: int,
    title: string,
    detail: string,
    genre: string,
    year: string,
    artwork: image,
    has-artwork: bool,
    monogram: string,
    kind: string,
    can-resume: bool,
    progress-label: string,
    saved: bool,
}

export struct TrackChoice {
    id: int,
    title: string,
}

export struct QueueRow {
    position: int,
    revision: string,
    title: string,
}

export struct WatchedRootRow {
    index: int,
    path: string,
    status: string,
}

export struct TmdbCandidateRow {
    id: string,
    title: string,
    year: string,
    genre: string,
    artwork: image,
    has-artwork: bool,
}

export struct EqualizerBandRow {
    index: int,
    frequency: string,
    gain: float,
    gain-label: string,
}

export struct BookmarkRow {
    index: int,
    name: string,
    time: string,
}

export struct NetworkHistoryRow {
    index: int,
    title: string,
    address: string,
    played: string,
}

export struct SubtitleResultRow {
    index: int,
    title: string,
    detail: string,
}

component ArchiveButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> space-activates: true;
    in property <string> style: "filled";
    callback clicked();
    callback pointer-moved();

    horizontal-stretch: 0;
    vertical-stretch: 0;
    min-width: root.style == "tab" || root.style == "plain" ? 0px : root.style == "icon" ? 48px : max(48px, content.min-width);
    min-height: root.style == "tab" ? 36px : max(32px, content.min-height);
    preferred-height: root.style == "tab" ? 36px : 32px;
    forward-focus: focus-scope;

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) { root.clicked(); }
    }

    surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: root.style == "chip" ? 16px : root.style == "tab" || root.style == "plain" ? 0px : root.style == "icon" ? 8px : 5px;
        border-width: root.style == "plain" || root.style == "tab" ? 0px : 1px;
        border-color: !root.enabled ? #48413b : root.primary ? #f46b32 : #51483f;
        background: root.style == "tab" || root.style == "plain"
            ? transparent
            : root.style == "icon"
            ? (root.primary
                ? (touch-area.pressed ? #d95a2b : touch-area.has-hover ? #ff8050 : #f46b32)
                : (touch-area.pressed ? #3b342e : touch-area.has-hover ? #51483f : #211e1bd9))
            : root.style == "chip" && !root.primary ? #211e1b
            : !root.enabled
            ? (root.primary ? #754932 : #282522)
            : touch-area.pressed
                ? (root.primary ? #d95a2b : #211e1b)
                : touch-area.has-hover
                    ? (root.primary ? #ff8050 : #3b342e)
                    : (root.primary ? #f46b32 : #302820);

        content := HorizontalLayout {
            padding-left: root.style == "tab" ? 10px : root.style == "plain" ? 0px : 12px;
            padding-right: root.style == "tab" ? 10px : root.style == "plain" ? 0px : 12px;
            padding-top: root.style == "tab" ? 0px : 4px;
            padding-bottom: root.style == "tab" ? 0px : 4px;
            alignment: center;
            Text {
                text: root.text;
                color: !root.enabled ? #ffffff78 : root.style == "tab" ? (root.primary ? #f46b32 : #ffffffB3) : root.style == "plain" ? #ffffff : root.primary && root.style != "chip" ? #141312 : #ffffff;
                font-size: root.style == "icon" ? 22px : 12px;
                font-weight: 650;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
        if root.style == "tab" && root.primary: Rectangle {
            x: 0px;
            y: parent.height - 2px;
            width: parent.width;
            height: 2px;
            background: #f46b32;
        }
    }

    touch-area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        moved => root.pointer-moved();
        clicked => {
            focus-scope.focus();
            root.clicked();
        }
    }

    focus-ring := Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        visible: root.enabled && focus-scope.has-focus;
        background: transparent;
        border-color: #f46b32;
        border-width: 2px;
        border-radius: 7px;
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (root.enabled && ((root.space-activates && event.text == Key.Space) || event.text == Key.Return)) {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }
}

component ArchiveLineEdit {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> password: false;
    callback edited(text: string);
    callback accepted(text: string);

    min-height: 32px;
    forward-focus: input;
    accessible-role: text-input;
    accessible-label: root.placeholder-text;
    accessible-value: root.password ? "" : root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-enabled: root.enabled;
    accessible-action-set-value(value) => {
        text = value;
        edited(value);
    }
    accessible-action-set-selection-offsets(anchor, focus) => input.set-selection-offsets(anchor, focus);

    Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;
        background: #211e1b;
        border-color: input.has-focus ? #f46b32 : #51483f;
        border-width: input.has-focus ? 2px : 1px;
        border-radius: 5px;

        input := TextInput {
            property <length> computed-x;

            x: 10px + min(0px, max(parent.width - 20px - self.width, self.computed-x));
            y: 2px;
            width: max(1px, max(parent.width - 20px - self.text-cursor-width, self.preferred-width));
            height: max(1px, parent.height - 4px);
            text <=> root.text;
            enabled: root.enabled;
            single-line: true;
            input-type: root.password ? InputType.password : InputType.text;
            vertical-alignment: center;
            color: #ffffff;
            selection-background-color: #f46b32;
            selection-foreground-color: #141312;
            accessible-role: none;
            cursor-position-changed(cursor-position) => {
                if cursor-position.x + self.computed-x < 0px {
                    self.computed-x = -cursor-position.x;
                } else if cursor-position.x + self.computed-x > parent.width - 20px - self.text-cursor-width {
                    self.computed-x = parent.width - 20px - cursor-position.x - self.text-cursor-width;
                }
            }
            edited => root.edited(self.text);
            accepted => root.accepted(self.text);
        }

        if root.text == "" && !input.has-focus: Text {
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: parent.height;
            text: root.placeholder-text;
            color: #ffffffA6;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
}

component ArchiveCheckBox {
    in property <string> text: "";
    in property <bool> enabled: true;
    in-out property <bool> checked: false;
    callback toggled();

    min-height: 24px;
    forward-focus: focus-scope;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-checked <=> root.checked;
    accessible-action-default => {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 17px;
            height: 17px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? #f46b32 : #302820;
            border-color: focus-scope.has-focus ? #f46b32 : #ffffff66;
            border-width: 1px;
            border-radius: 3px;
            if root.checked: Text {
                text: "✓";
                color: #141312;
                font-size: 13px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            if focus-scope.has-focus: Rectangle {
                x: -3px;
                y: -3px;
                width: 23px;
                height: 23px;
                background: transparent;
                border-color: #ffffff;
                border-width: 2px;
                border-radius: 5px;
                accessible-role: none;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? #ffffff : #ffffff78;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => {
            focus-scope.focus();
            root.checked = !root.checked;
            root.toggled();
        }
    }
    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked;
                root.toggled();
                accept
            } else {
                reject
            }
        }
    }
}

component ArchiveComboBoxRow inherits Rectangle {
    in property <string> value;
    in property <string> current-value;
    in property <int> item-index;
    in property <int> item-count;
    in property <int> active-index;
    in property <int> sync-generation;
    callback matched(index: int);
    callback activated(index: int);

    height: 32px;
    background: root.item-index == root.active-index ? #f46b32 : #211e1b;
    accessible-role: list-item;
    accessible-label: root.value;
    accessible-item-selectable: true;
    accessible-item-selected: root.item-index == root.active-index;
    accessible-item-index: root.item-index;
    accessible-item-count: root.item-count;
    accessible-action-default => root.activated(root.item-index);

    function update-match() {
        if root.value == root.current-value {
            root.matched(root.item-index);
        }
    }
    init => root.update-match();
    changed value => root.update-match();
    changed item-index => root.update-match();
    changed current-value => root.update-match();
    changed sync-generation => root.update-match();

    Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.value;
        color: root.item-index == root.active-index ? #141312 : #ffffff;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => root.activated(root.item-index);
    }
}

component ArchiveComboBox {
    in property <[string]> model: [];
    in-out property <string> current-value: "";
    in property <bool> enabled: true;
    out property <bool> has-focus: focus-scope.has-focus;
    private property <int> active-index: 0;
    private property <bool> expanded: false;
    private property <int> sync-generation: 0;
    private property <bool> value-match-found: false;
    callback selected(value: string);

    min-width: 160px;
    min-height: 32px;
    forward-focus: focus-scope;
    accessible-role: combobox;
    accessible-label: "Choose a value";
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-value: root.current-value;
    accessible-action-expand => root.open-popup();

    function sync-active-index() {
        root.active-index = 0;
        root.value-match-found = false;
        root.sync-generation += 1;
    }
    function open-popup() {
        if root.enabled && root.model.length > 0 {
            root.sync-active-index();
            root.expanded = true;
            popup.show();
        }
    }
    function close-popup() {
        root.expanded = false;
        popup.close();
    }
    function move-active(delta: int) {
        if root.model.length > 0 {
            root.active-index = Math.mod(root.active-index + delta + root.model.length, root.model.length);
        }
    }
    function choose-active() {
        if root.active-index >= 0 && root.active-index < root.model.length {
            root.current-value = root.model[root.active-index];
            root.selected(root.current-value);
            root.close-popup();
        }
    }
    init => root.sync-active-index();
    changed current-value => root.sync-active-index();
    changed model => root.sync-active-index();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #211e1b;
        border-color: focus-scope.has-focus ? #f46b32 : #51483f;
        border-width: focus-scope.has-focus ? 2px : 1px;
        border-radius: 5px;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 9px;
            Text {
                horizontal-stretch: 1;
                text: root.current-value;
                color: root.enabled ? #ffffff : #ffffff78;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Text { text: "⌄"; color: #f46b32; vertical-alignment: center; accessible-role: none; }
        }
        TouchArea {
            width: parent.width;
            height: parent.height;
            enabled: root.enabled;
            clicked => {
                focus-scope.focus();
                if root.expanded { root.close-popup(); } else { root.open-popup(); }
            }
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        changed has-focus => {
            if self.has-focus { root.expanded = false; }
        }
        key-pressed(event) => {
            if !root.enabled { return reject; }
            if event.text == Key.DownArrow || event.text == Key.Space || event.text == Key.Return {
                if !root.expanded { root.open-popup(); }
                else if event.text == Key.DownArrow { root.move-active(1); }
                else { root.choose-active(); }
                accept
            } else if event.text == Key.UpArrow {
                if !root.expanded { root.open-popup(); }
                else { root.move-active(-1); }
                accept
            } else if event.text == Key.LeftArrow || event.text == Key.RightArrow {
                accept
            } else if event.text == Key.Escape && root.expanded {
                root.close-popup();
                accept
            } else {
                reject
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        height: min(root.model.length, 6) * 32px + 4px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.DownArrow { root.move-active(1); accept }
                else if event.text == Key.UpArrow { root.move-active(-1); accept }
                else if event.text == Key.Return || event.text == Key.Space { root.choose-active(); accept }
                else if event.text == Key.Escape { root.close-popup(); accept }
                else { reject }
            }
            focus-changed-event => { root.expanded = self.has-focus; }
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #211e1b;
                border-color: #51483f;
                border-width: 1px;
                border-radius: 5px;
                ScrollView {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    content-y: -max(0, root.active-index - 5) * 32px;
                    accessible-role: list;
                    VerticalLayout {
                        width: parent.width;
                        alignment: start;
                        for value[index] in root.model: ArchiveComboBoxRow {
                            width: parent.width;
                            value: value;
                            current-value: root.current-value;
                            item-index: index;
                            item-count: root.model.length;
                            active-index: root.active-index;
                            sync-generation: root.sync-generation;
                            matched(index) => {
                                if !root.value-match-found {
                                    root.active-index = index;
                                    root.value-match-found = true;
                                }
                            }
                            activated(index) => {
                                root.active-index = index;
                                root.choose-active();
                                focus-scope.focus();
                            }
                        }
                    }
                }
            }
        }
    }
}

component SeekSlider {
    in-out property <float> value: minimum;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> keyboard-step: root.step;
    in property <bool> enabled: true;
    in property <int> current-track-id: -1;
    in property <string> current-load-generation: "0";
    in property <string> seek-label: "Seek playback position";
    private property <bool> dragging: false;
    private property <int> gesture-track-id: -1;
    private property <string> gesture-load-generation: "0";
    private property <length> pointer-start-x: 0px;
    private property <float> pointer-start-value: 0;
    private property <float> progress: root.maximum > root.minimum
        ? clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0.0, 1.0)
        : 0.0;
    private property <length> handle-center-x: 10px + root.progress * max(0px, root.width - 20px);

    callback changed(value: float, track-id: int, load-generation: string);
    callback released(value: float, track-id: int, load-generation: string);
    callback cancelled();

    horizontal-stretch: 1;
    min-height: 24px;
    accessible-role: slider;
    accessible-label: root.seek-label;
    accessible-enabled: root.enabled;
    accessible-orientation: Orientation.horizontal;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: min(root.step, max((root.maximum - root.minimum) / 100, 0.01));
    forward-focus: focus-scope;

    changed enabled => {
        if (!root.enabled && root.dragging) {
            root.cancel-gesture();
        }
    }

    function capture-gesture() {
        root.gesture-track-id = root.current-track-id;
        root.gesture-load-generation = root.current-load-generation;
        root.dragging = true;
    }

    function update-value(next-value: float) {
        let clamped = max(root.minimum, min(root.maximum, next-value));
        if (root.value != clamped) {
            root.value = clamped;
            root.changed(root.value, root.gesture-track-id, root.gesture-load-generation);
        }
    }

    function value-at-position(position: length) -> float {
        let travel = max(0px, root.width - 20px);
        if (travel <= 0px || root.maximum <= root.minimum) {
            root.minimum
        } else {
            root.minimum + clamp((position - 10px) / travel, 0.0, 1.0) * (root.maximum - root.minimum)
        }
    }

    function value-at-delta(delta: length) -> float {
        let travel = max(0px, root.width - 20px);
        if (travel <= 0px || root.maximum <= root.minimum) {
            root.minimum
        } else {
            root.pointer-start-value + delta * (root.maximum - root.minimum) / travel
        }
    }

    function commit-gesture() {
        if (root.dragging) {
            root.released(root.value, root.gesture-track-id, root.gesture-load-generation);
            root.dragging = false;
            root.gesture-track-id = -1;
            root.gesture-load-generation = "0";
            root.pointer-start-x = 0px;
            root.pointer-start-value = root.value;
        }
    }

    function cancel-gesture() {
        if (root.dragging) {
            root.dragging = false;
            root.gesture-track-id = -1;
            root.gesture-load-generation = "0";
            root.pointer-start-x = 0px;
            root.pointer-start-value = root.value;
            root.cancelled();
        }
    }

    accessible-action-set-value(value) => {
        if (value.is-float()) {
            root.capture-gesture();
            root.update-value(value.to-float());
            root.commit-gesture();
        }
    }
    accessible-action-increment => {
        root.capture-gesture();
        root.update-value(root.value + root.step);
        root.commit-gesture();
    }
    accessible-action-decrement => {
        root.capture-gesture();
        root.update-value(root.value - root.step);
        root.commit-gesture();
    }

    rail := Rectangle {
        x: 10px;
        y: (parent.height - 4px) / 2;
        width: max(0px, parent.width - 20px);
        height: 4px;
        background: #39332e;
        border-radius: 2px;
    }

    fill := Rectangle {
        x: 10px;
        y: rail.y;
        width: max(0px, root.handle-center-x - 10px);
        height: rail.height;
        background: #f46b32;
        border-radius: rail.border-radius;
    }

    handle := Rectangle {
        x: root.handle-center-x - 10px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        background: #f46b32;
        border-color: #ffffff;
        border-width: 1px;
        border-radius: 10px;

        inner := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            background: #ffffff;
            border-radius: 4px;
        }
    }

    focus-ring := Rectangle {
        x: handle.x - 3px;
        y: handle.y - 3px;
        width: handle.width + 6px;
        height: handle.height + 6px;
        background: transparent;
        border-color: #f46b32;
        border-width: focus-scope.has-focus ? 2px : 0px;
        border-radius: 13px;
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;

        changed has-focus => {
            if (!self.has-focus) {
                root.cancel-gesture();
            }
        }

        key-pressed(event) => {
            if (!root.enabled || root.step <= 0) {
                return reject;
            }

            if (event.modifiers.control && (event.text == Key.LeftArrow || event.text == Key.RightArrow)) {
                return reject;
            }

            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                if (!root.dragging) { root.capture-gesture(); }
                root.update-value(root.value + root.keyboard-step);
                return accept;
            } else if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                if (!root.dragging) { root.capture-gesture(); }
                root.update-value(root.value - root.keyboard-step);
                return accept;
            } else if (event.text == Key.Home) {
                if (!root.dragging) { root.capture-gesture(); }
                root.update-value(root.minimum);
                return accept;
            } else if (event.text == Key.End) {
                if (!root.dragging) { root.capture-gesture(); }
                root.update-value(root.maximum);
                return accept;
            }

            reject
        }

        key-released(event) => {
            if (root.dragging && (event.text == Key.RightArrow || event.text == Key.UpArrow
                || event.text == Key.LeftArrow || event.text == Key.DownArrow
                || event.text == Key.Home || event.text == Key.End)) {
                root.commit-gesture();
                return accept;
            }
            reject
        }
    }

    touch-area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.cancel) {
                root.cancel-gesture();
                return;
            }
            if (event.button != PointerEventButton.left) {
                return;
            }
            if (event.kind == PointerEventKind.down) {
                root.capture-gesture();
                focus-scope.focus();
                if (self.mouse-x < handle.x || self.mouse-x > handle.x + handle.width) {
                    root.update-value(root.value-at-position(self.mouse-x));
                }
                root.pointer-start-x = self.mouse-x;
                root.pointer-start-value = root.value;
            } else if (event.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.update-value(root.value-at-delta(self.mouse-x - root.pointer-start-x));
                    root.commit-gesture();
                }
            }
        }

        moved => {
            if (root.dragging) {
                root.update-value(root.value-at-delta(self.mouse-x - root.pointer-start-x));
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "VLC Première";
    icon: @image-url("../assets/icons/rust-vlc.png");
    preferred-width: 1440px;
    preferred-height: 960px;
    min-width: 900px;
    min-height: 650px;
    background: #141312;
    no-frame: root.movie-fullscreen;
    default-font-family: "Inter";
    default-font-size: 14px;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in property <string> current-view: "movies";
