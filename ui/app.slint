    callback movie-filter-changed(string);
    callback movie-view-changed(string);
    callback movie-genre-changed(string);
    callback movie-sort-changed(string);
    callback music-genre-changed(string);
    callback music-sort-changed(string);
    callback toggle-saved-movie(int);
    callback close-movie-details();
    callback clear-movie-filters();
    callback clear-music-filters();
    callback movie-poster-clicked(int);
    callback select-movie(int);
    callback relink-media(int);
    callback close-tmdb-picker();
    callback select-tmdb-candidate(string);
