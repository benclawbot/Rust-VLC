    in property <bool> tmdb-picker-open: false;
    in property <string> tmdb-picker-status: "";
    in property <[TmdbCandidateRow]> tmdb-candidates: [];
    in property <bool> tmdb-picker-busy: false;
    in-out property <string> music-genre: "All genres";
    in-out property <string> music-sort: "Recently added";
    in property <string> music-results-heading: "Albums";
    in property <string> music-results-count: "0 albums";
    in property <string> artwork-target-title: "";
    in property <bool> artwork-target-ready: false;
    in property <bool> artwork-target-missing: false;
    in property <bool> artwork-target-video: false;
    in property <string> artwork-query: "";
    in-out property <string> tmdb-token-input: "";
    in property <bool> tmdb-token-available: false;
    in property <string> settings-status: "";
    in property <bool> settings-error: false;
    in-out property <string> audio-delay-input: "0";
    in-out property <string> subtitle-delay-input: "0";
    in-out property <string> jump-time-input: "";
    in property <string> status-message: "";
    in-out property <bool> adjusting-seek: false;
    in-out property <string> playlist-rename-input: "";
    in-out property <bool> confirm-delete-playlist: false;
    in-out property <bool> adjusting-volume: false;
    in-out property <bool> adjusting-rate: false;
    in-out property <bool> about-open: false;
    in-out property <bool> settings-open: false;

    private property <length> content-gutter: root.width <= 900px ? 28px : root.width <= 1023px ? 32px : min(64px, max(24px, root.width * 0.042));
    private property <length> content-width: min(root.width, 1600px) - 2 * root.content-gutter;
    private property <int> poster-columns: root.width >= 1280px ? 6 : root.width >= 1024px ? 5 : root.width > 900px ? 4 : 3;
    private property <length> poster-card-width: (root.content-width - (root.poster-columns - 1) * 18px) / root.poster-columns;

    changed opened-playlist-id => { root.confirm-delete-playlist = false; }
    changed music-detail-open => { if (!root.music-detail-open) { root.confirm-delete-playlist = false; } }
    changed movie-fullscreen => {
        if (root.movie-fullscreen) {
            movie-keyboard-scope.focus();
        }
    }

    callback navigate(string);
    callback music-section-changed(string);
    callback back-music-detail();
    callback open-music-group(int);
    callback open-playlist(int);
    callback shuffle-opened-playlist();
    callback toggle-playlist-entry(int, int, int, int, bool);
    callback move-playlist-entry(int, int, int, int, int);
    callback remove-playlist-entry(int, int, int, int);
    callback playlist-rename-input-changed(string);
    callback rename-opened-playlist(int, string);
    callback delete-playlist(int);
