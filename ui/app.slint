    callback exit-movie-fullscreen();
    callback return-to-video();
    callback open-picture-in-picture();
    callback close-picture-in-picture();
    callback save-video-frame();
    callback equalizer-enabled-changed(bool);
    callback equalizer-preset-changed(string);
    callback equalizer-preamp-draft-changed(float);
    callback equalizer-preamp-changed(float);
    callback equalizer-preamp-cancelled();
    callback equalizer-band-draft-changed(int, float);
    callback equalizer-band-changed(int, float);
    callback equalizer-band-cancelled();
    callback set-ab-repeat-point(string, int, string);
    callback clear-ab-repeat(int, string);
    callback set-sleep-timer(int);
    callback cast-address-draft-changed(string);
    callback set-cast-target(string);
    callback use-local-output();
    callback bookmark-name-changed(string);
    callback add-bookmark();
    callback bookmark-jump(int);
    callback remove-bookmark(int);
    callback network-url-input-changed(string);
    callback play-network-url(bool);
    callback open-network-history(int);
    callback remove-network-history(int);
    callback search-subtitles(string);
    callback subtitle-languages-changed(string);
    callback download-subtitle(int);
    callback save-opensubtitles-credentials(string, string);
    callback remove-opensubtitles-credentials();
    callback import-m3u8();
    callback export-m3u8(int);
    callback fullscreen-activity();
    callback retry-local-artwork();
    callback find-online-artwork();
    callback tmdb-token-input-changed(string);
    callback save-tmdb-token();
    callback remove-tmdb-token();
    callback settings-closed();
    callback add-watched-root();
    callback rescan-watched-roots();
    callback remove-watched-root(int);
    callback previous();
    callback toggle-pause();
    callback next();
    callback stop();
    callback seek-changed(float, int, string, bool);
    callback volume-changed(float, bool);
    callback playback-rate-changed(float, bool);
    callback cycle-repeat-mode();
    callback playback-shuffle-changed(bool);
    callback select-audio-track(int, int);
    callback select-subtitle-track(int, int);
    callback add-subtitle-file();
    callback audio-delay-changed(string);
    callback subtitle-delay-changed(string);
    callback audio-delay-draft-changed(string);
    callback subtitle-delay-draft-changed(string);
    callback jump-time-changed(string);
    callback jump-to-time();
    callback select-chapter(int, int);
    callback set-video-fill(bool);
    callback queue-jump(string, int);
    callback queue-move(string, int, int);
    callback queue-remove(string, int);

    forward-focus: movie-keyboard-scope;
    movie-keyboard-scope := FocusScope {
        capture-key-pressed(event) => {
            if root.movie-fullscreen {
                root.fullscreen-activity();
            }
            if (root.tmdb-picker-open && event.text == Key.Escape) {
                root.close-tmdb-picker();
                movie-keyboard-scope.focus();
                accept
            } else if (root.settings-open && event.text == Key.Escape) {
                root.settings-open = false;
                root.tmdb-token-input = "";
                root.settings-closed();
                movie-keyboard-scope.focus();
                accept
            } else if (root.movie-details-open && event.text == Key.Escape) {
                root.close-movie-details();
                movie-keyboard-scope.focus();
                accept
            } else if (root.movie-fullscreen && event.text == Key.Escape) {
                root.exit-movie-fullscreen();
                accept
            } else if (root.about-open && event.text == Key.Escape) {
                root.about-open = false;
                movie-keyboard-scope.focus();
                accept
            } else {
                reject
            }
        }
        key-pressed(event) => {
            if root.settings-open || root.about-open || root.movie-details-open || root.tmdb-picker-open || !root.has-current-track {
                reject
            } else if root.playing-video && root.has-video-frame && event.text == Key.P {
                root.open-picture-in-picture();
                accept
            } else if root.can-return-to-video && event.text == Key.F {
                root.return-to-video();
                accept
            } else if event.modifiers.control && event.text == Key.LeftArrow {
                root.previous();
                accept
            } else if event.modifiers.control && event.text == Key.RightArrow {
                root.next();
                accept
            } else if event.text == Key.Space && root.can-toggle-pause {
                root.toggle-pause();
                accept
            } else if event.text == Key.LeftArrow && root.can-seek {
                root.seek-changed(max(0.0, root.player-position-ms - 10000.0), root.current-track-id, root.current-load-generation, true);
                accept
            } else if event.text == Key.RightArrow && root.can-seek {
                root.seek-changed(min(root.player-duration-ms, root.player-position-ms + 10000.0), root.current-track-id, root.current-load-generation, true);
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0px;

            if !root.movie-fullscreen: Rectangle {
                height: 66px;
                background: #141312;
                HorizontalLayout {
                    x: root.width > 1600px ? (root.width - 1600px) / 2 : 0px;
                    width: min(root.width, 1600px);
                    y: (parent.height - self.height) / 2;
                    height: 44px;
                    padding-left: root.content-gutter;
                    padding-right: root.content-gutter;
                    spacing: 12px;
                    Rectangle {
                        width: 360px;
                        height: 44px;
                        background: #211e1b;
                        border-color: #3b3631;
                        border-width: 1px;
                        border-radius: 7px;
                        HorizontalLayout {
                            padding: 3px;
                            spacing: 4px;
                            ArchiveButton {
                                width: 174px;
                                height: 36px;
                                text: "Movies";
                                primary: root.current-view == "movies";
                                clicked => root.navigate("movies");
                            }
                            ArchiveButton {
                                width: 174px;
                                height: 36px;
                                text: "Music";
                                primary: root.current-view == "music";
                                clicked => root.navigate("music");
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ArchiveButton {
                        text: root.queue-open ? "Hide queue" : "Queue";
                        clicked => { root.queue-open = !root.queue-open; }
                    }
                    ArchiveButton {
                        text: "☷ Tools";
                        style: "plain";
                        accessible-label: root.tools-open ? "Hide player tools" : "Show player tools";
                        clicked => {
                            if (!root.tools-open && !root.has-current-track) { root.tools-tab = "Stream"; }
                            root.tools-open = !root.tools-open;
                        }
                    }
                    ArchiveButton {
                        text: "Options";
                        style: "plain";
                        accessible-label: "Open options";
                        clicked => {
                            root.tmdb-token-input = "";
                            root.settings-open = true;
                        }
                    }
                    ArchiveButton {
                        text: "About";
                        style: "plain";
                        clicked => { root.about-open = true; }
                    }
                }
            }

            if !root.movie-fullscreen: Rectangle {
                background: #141312;
                vertical-stretch: 1;
                VerticalLayout {
                    x: root.width > 1600px ? (root.width - 1600px) / 2 : 0px;
                    width: min(root.width, 1600px);
                    padding-left: root.content-gutter;
                    padding-right: root.content-gutter;
                    padding-top: 12px;
                    padding-bottom: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        height: 86px;
                        spacing: 18px;
                        VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 1px;
                            Text {
                                text: root.current-view == "movies" ? "YOUR FILMS, IN ONE PLACE" : "YOUR MUSIC, IN ONE PLACE";
                                color: #f46b32;
                                font-size: 10px;
                                font-weight: 700;
                                letter-spacing: 1.4px;
                            }
                            Text {
                                text: root.current-view == "movies" ? "Movies" : "Music";
                                color: #ffffff;
                                font-size: 34px;
                                font-weight: 740;
                            }
                            Text {
                                text: root.current-view == "movies" ? "A clear, browsable shelf for the films already in your library." : "Browse artwork-led albums, artists and genres, or collect songs into playlists from your local library.";
                                color: #ffffffB3;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            width: min(350px, max(230px, parent.width * 0.29));
                            spacing: 4px;
                            Text { text: root.current-view == "movies" ? "Search your films" : "Search your music"; color: #ffffffB3; font-size: 10px; font-weight: 700; }
                            ArchiveLineEdit {
                                height: 38px;
                                text <=> root.search-query;
                                placeholder-text: root.current-view == "movies" ? "Title, year, genre or story" : "Album, artist, track or genre";
                                edited(text) => root.search-changed(text);
                                accessible-label: "Search the current collection";
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #3b3631; }

                    if root.library-status != "": Text {
                        height: 14px;
                        text: root.library-status;
                        color: #ffffffB3;
                        font-size: 9px;
                        overflow: elide;
                    }

                    if root.current-view == "music": HorizontalLayout {
                        height: 36px;
                        spacing: 2px;
                        ArchiveButton { text: "Albums"; style: "tab"; primary: root.music-section == "albums"; clicked => root.music-section-changed("albums"); }
                        ArchiveButton { text: "Artists"; style: "tab"; primary: root.music-section == "artists"; clicked => root.music-section-changed("artists"); }
                        ArchiveButton { text: "Tracks"; style: "tab"; primary: root.music-section == "tracks"; clicked => root.music-section-changed("tracks"); }
                        ArchiveButton { text: "Genres"; style: "tab"; primary: root.music-section == "genres"; clicked => root.music-section-changed("genres"); }
                        ArchiveButton { text: "Playlists"; style: "tab"; primary: root.music-section == "playlists"; clicked => root.music-section-changed("playlists"); }
                        Rectangle { horizontal-stretch: 1; }
                        ArchiveButton { text: "Import folder"; clicked => root.import-folder(); }
                        ArchiveButton { text: "Add audio files"; primary: true; clicked => root.open-audio-files(); }
                    }

                    if root.current-view == "movies": HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        if root.movie-back-label != "": ArchiveButton { text: root.movie-back-label; clicked => root.back-movie(); }
                        ArchiveButton { text: "All films  " + root.movie-library-count; style: "tab"; primary: root.movie-view == "all"; clicked => root.movie-view-changed("all"); }
                        ArchiveButton { text: "My List  " + root.saved-movie-count; style: "tab"; primary: root.movie-view == "my-list"; clicked => root.movie-view-changed("my-list"); }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.current-view == "movies": HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Text { text: "GENRE"; color: #ffffffB3; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                        ArchiveComboBox {
                            width: min(220px, max(150px, parent.width * 0.22));
                            model: root.movie-genres;
                            current-value <=> root.movie-genre;
                            accessible-label: "Filter movies by genre";
                            selected(value) => root.movie-genre-changed(value);
                        }
                        Text { text: "SORT"; color: #ffffffB3; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                        ArchiveComboBox {
                            width: min(190px, max(150px, parent.width * 0.18));
                            model: ["Recently added", "Title A–Z", "Year newest", "Year oldest"];
                            current-value <=> root.movie-sort;
                            accessible-label: "Sort movies";
                            selected(value) => root.movie-sort-changed(value);
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.search-query != "" || root.movie-view != "all" || root.movie-genre != "All genres" || root.movie-filter != "all" || root.movie-sort != "Recently added": ArchiveButton { text: "Clear filters"; style: "plain"; clicked => root.clear-movie-filters(); }
                    }

                    if root.current-view == "music": HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Text { text: "GENRE"; color: #ffffffB3; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                        ArchiveComboBox {
                            width: min(190px, max(150px, parent.width * 0.18));
                            model: root.music-genres;
                            current-value <=> root.music-genre;
                            accessible-label: "Filter music by genre";
                            selected(value) => root.music-genre-changed(value);
                        }
                        Text { text: "SORT"; color: #ffffffB3; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                        ArchiveComboBox {
                            width: min(185px, max(150px, parent.width * 0.18));
                            model: root.music-section == "albums" && root.music-detail-open ? ["Disc / track", "Recently added", "Title A–Z", "Artist A–Z"] : ["Recently added", "Title A–Z", "Artist A–Z"];
                            current-value <=> root.music-sort;
                            accessible-label: "Sort music";
                            selected(value) => root.music-sort-changed(value);
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.search-query != "" || root.music-genre != "All genres" || (root.music-sort != "Recently added" && !(root.music-section == "albums" && root.music-detail-open && root.music-sort == "Disc / track")): ArchiveButton { text: "Clear filters"; style: "plain"; clicked => root.clear-music-filters(); }
                    }

                    if root.current-view == "movies": HorizontalLayout {
                        height: 30px;
                        spacing: 4px;
                        Text { text: root.movie-results-heading; color: #ffffff; font-size: 16px; font-weight: 680; vertical-alignment: center; }
                        Text { text: root.movie-results-count; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.current-view == "movies": HorizontalLayout {
                        height: 30px;
                        spacing: 4px;
                        ArchiveButton { text: "All"; style: "chip"; primary: root.movie-filter == "all"; clicked => root.movie-filter-changed("all"); }
                        ArchiveButton { text: "Continue"; style: "chip"; primary: root.movie-filter == "continue"; clicked => root.movie-filter-changed("continue"); }
                        ArchiveButton { text: "Completed"; style: "chip"; primary: root.movie-filter == "completed"; clicked => root.movie-filter-changed("completed"); }
                        ArchiveButton { text: "Unwatched"; style: "chip"; primary: root.movie-filter == "unwatched"; clicked => root.movie-filter-changed("unwatched"); }
                        Rectangle { horizontal-stretch: 1; }
                        ArchiveButton { text: "Import folder"; clicked => root.import-folder(); }
                        ArchiveButton { text: "Add movies"; primary: true; clicked => root.open-movie-files(); }
                    }

                    if root.current-view == "music": HorizontalLayout {
                        height: 30px;
                        spacing: 8px;
                        Text { text: root.music-results-heading; color: #ffffff; font-size: 16px; font-weight: 680; vertical-alignment: center; }
                        Text { text: root.music-results-count; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.current-view == "music" && (root.music-section == "tracks" || root.music-detail-open): HorizontalLayout {
                        height: 28px;
                        spacing: 10px;
                        ArchiveCheckBox {
                            text: "Select all shown";
                            checked <=> root.select-all-checked;
                            enabled: root.select-all-enabled;
                            toggled => root.select-all(self.checked);
                        }
                        Text {
                            text: root.selected-count + " selected · " + root.visible-count + " shown";
                            color: #ffffffB3;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.current-view == "music" && root.music-section == "playlists" && !root.music-detail-open: HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        Text { text: "NEW PLAYLIST"; color: #ffffffB3; font-size: 9px; font-weight: 700; vertical-alignment: center; }
                        ArchiveLineEdit {
                            width: 260px;
                            text <=> root.new-playlist-name;
                            placeholder-text: "Playlist name";
                            accessible-label: "New playlist name";
                            edited(text) => root.playlist-name-changed(text);
                            accepted(text) => root.create-playlist(text);
                        }
                        ArchiveButton {
                            text: "Create playlist";
                            enabled: root.new-playlist-name != "";
                            primary: true;
                            clicked => root.create-playlist(root.new-playlist-name);
                        }
                        ArchiveButton { text: "Import M3U8"; accessible-label: "Import an M3U8 playlist"; clicked => root.import-m3u8(); }
                        if root.playlist-io-status != "": Text { horizontal-stretch: 1; text: root.playlist-io-status; color: #ffffffB3; font-size: 9px; vertical-alignment: center; overflow: elide; }
                    }

                    if root.current-view == "music" && root.has-selection && (root.music-section == "tracks" || root.music-detail-open): HorizontalLayout {
                        height: root.width > 1150px ? 40px : 76px;
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                height: 36px;
                                spacing: 8px;
                                ArchiveComboBox {
                                    width: 210px;
                                    model: root.playlist-targets;
                                    current-value <=> root.selected-playlist-name;
                                    enabled: root.playlist-targets.length > 0;
                                    accessible-label: "Playlist receiving checked tracks";
                                    selected(value) => root.select-target-playlist(value);
                                }
                                ArchiveButton { text: "Play selected"; primary: true; clicked => root.play-selected(); }
                                ArchiveButton { text: "Add checked"; enabled: root.has-selected-playlist; clicked => root.add-selected-to-playlist(root.allow-playlist-duplicates); }
                                ArchiveCheckBox { text: "Allow duplicates"; checked <=> root.allow-playlist-duplicates; accessible-label: "Allow repeated tracks in this playlist"; }
                                if root.width > 1150px: ArchiveLineEdit {
                                    width: 180px;
                                    text <=> root.new-playlist-name;
                                    placeholder-text: "New playlist name";
                                    accessible-label: "Name for a playlist from selected tracks";
                                    edited(text) => root.playlist-name-changed(text);
                                    accepted(text) => root.create-playlist-from-selection(text, root.allow-playlist-duplicates);
                                }
                                if root.width > 1150px: ArchiveButton {
                                    text: "New playlist";
                                    enabled: root.new-playlist-name != "";
                                    accessible-label: "Create a playlist from the selected tracks";
                                    clicked => root.create-playlist-from-selection(root.new-playlist-name, root.allow-playlist-duplicates);
                                }
                            }
                            if root.width <= 1150px: HorizontalLayout {
                                height: 36px;
                                spacing: 8px;
                                ArchiveLineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.new-playlist-name;
                                    placeholder-text: "New playlist name";
                                    accessible-label: "Name for a playlist from selected tracks";
                                    edited(text) => root.playlist-name-changed(text);
                                    accepted(text) => root.create-playlist-from-selection(text, root.allow-playlist-duplicates);
                                }
                                ArchiveButton {
                                    text: "New playlist";
                                    enabled: root.new-playlist-name != "";
                                    accessible-label: "Create a playlist from the selected tracks";
                                    clicked => root.create-playlist-from-selection(root.new-playlist-name, root.allow-playlist-duplicates);
                                }
                            }
                        }
                    }

                    if root.runtime-ready && !root.runtime-available: Rectangle {
                        height: 48px;
                        background: #2b211c;
                        border-color: #5a392a;
                        border-width: 1px;
                        border-radius: 6px;
                        Text {
                            x: 12px;
                            y: 6px;
                            width: parent.width - 24px;
                            height: parent.height - 12px;
                            color: #ffffff;
                            font-size: 11px;
                            wrap: word-wrap;
                            text: root.runtime-message;
                            vertical-alignment: center;
                        }
                    }

                    if root.current-view == "music" && !root.has-tracks: Rectangle {
                        vertical-stretch: 1;
                        background: #1b1917;
                        border-color: #3b3631;
                        border-width: 1px;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 28px;
                            spacing: 12px;
                            Text { text: "Your music library is empty"; color: #ffffff; font-size: 22px; font-weight: 700; }
                            Text { text: "Import a folder or add local audio files. Tags and nearby artwork are read on this device."; color: #ffffffB3; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 36px;
                                ArchiveButton { width: 220px; height: 36px; text: "Add local audio"; primary: true; clicked => root.open-audio-files(); }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    if root.current-view == "music" && root.has-tracks && root.music-section != "tracks" && !root.music-detail-open && root.has-music-cards: ScrollView {
                        vertical-stretch: 1;
                        content-width: self.width;
                        FlexboxLayout {
                            width: parent.width;
                            spacing: 18px;
                            flex-direction: row;
                            flex-wrap: wrap;
                            for card in root.music-cards: VerticalLayout {
                                width: root.poster-card-width;
                                height: root.poster-card-width + 64px;
                                spacing: 4px;
                                Rectangle {
                                    width: parent.width;
                                    height: parent.width;
                                    clip: true;
                                    if card.has-artwork: Image { width: parent.width; height: parent.height; source: card.artwork; image-fit: cover; accessible-label: card.title + " artwork"; }
                                    if !card.has-artwork: Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: #302820;
                                        Text { text: card.monogram; color: #f46b32; font-size: 42px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        accessible-role: button;
                                        accessible-label: (card.kind == "playlist" ? "Open playlist " : "Open ") + card.title;
                                        clicked => {
                                            if (card.kind == "playlist") { root.open-playlist(card.id); }
                                            else { root.open-music-group(card.id); }
                                        }
                                    }
                                }
                                ArchiveButton {
                                    width: parent.width;
                                    height: 22px;
                                    style: "plain";
                                    text: card.title;
                                    accessible-label: "Open " + card.title;
                                    clicked => {
                                        if (card.kind == "playlist") { root.open-playlist(card.id); }
                                        else { root.open-music-group(card.id); }
                                    }
                                }
                                Text { text: card.detail; color: #ffffffB3; font-size: 10px; overflow: elide; }
                                if card.genre != "": Text { text: card.genre; color: #aaa196; font-size: 9px; overflow: elide; }
                            }
                        }
                    }

                    if root.current-view == "music" && root.music-section != "tracks" && !root.music-detail-open && !root.has-music-cards && root.has-tracks: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text { text: "No matching items in this view."; color: #ffffffB3; horizontal-alignment: center; }
                        if root.search-query != "" || root.music-genre != "All genres" || (root.music-sort != "Recently added" && !(root.music-section == "albums" && root.music-detail-open && root.music-sort == "Disc / track")): ArchiveButton { text: "Clear filters"; style: "plain"; clicked => root.clear-music-filters(); }
                    }

                    if root.current-view == "music" && (root.music-section == "tracks" || root.music-detail-open) && root.visible-count > 0: ListView {
                        vertical-stretch: 1;
                        accessible-role: list;
                        for track in root.tracks: Rectangle {
                            height: 58px;
                            background: track.selected ? #2a211b : track.unavailable ? #29211e : #1b1917;
                            border-radius: 4px;
                            accessible-role: list-item;
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                accessible-role: button;
                                accessible-label: track.unavailable ? track.title + " is unavailable" : "Play " + track.title;
                                clicked => root.play-track(track.id, track.index);
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 9px;
                                ArchiveCheckBox {
                                    width: 28px;
                                    text: "";
                                    checked: track.selected;
                                    accessible-label: "Select " + track.title;
                                    toggled => {
                                        if root.music-section == "playlists" && root.music-detail-open {
                                            root.toggle-playlist-entry(root.opened-playlist-id, track.index, track.playlist-position, track.id, self.checked);
                                        } else {
                                            root.toggle-track(track.id, self.checked);
                                        }
                                    }
                                }
                                if track.has-artwork: Image { width: 40px; height: 40px; source: track.artwork; image-fit: cover; accessible-label: track.title + " artwork"; }
                                if !track.has-artwork: Rectangle { width: 40px; height: 40px; background: #302820; Text { text: track.monogram; color: #f46b32; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; } }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    ArchiveButton {
                                        horizontal-stretch: 1;
                                        height: 24px;
                                        style: "plain";
                                        text: track.title;
                                        accessible-label: track.unavailable ? track.title + " is unavailable" : "Play " + track.title;
                                        clicked => root.play-track(track.id, track.index);
                                    }
                                    Text { text: track.detail; color: #ffffffB3; font-size: 10px; overflow: elide; }
                                }
                                Text { width: 110px; text: track.genre; color: #ffffffB3; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                Text { width: 48px; text: track.duration; color: #ffffffB3; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                                ArchiveButton {
                                    text: "Play next";
                                    style: "plain";
                                    height: 30px;
                                    accessible-label: "Play " + track.title + " next";
                                    enabled: root.runtime-available;
                                    clicked => root.play-next-track(track.id, track.index);
                                }
                                if track.local-media: ArchiveButton {
                                    text: "Locate file";
                                    accessible-label: "Choose a replacement file for " + track.title;
                                    clicked => root.relink-media(track.id);
                                }
                                if root.music-section == "playlists" && root.music-detail-open: HorizontalLayout {
                                    spacing: 3px;
                                    ArchiveButton {
                                        text: "Up";
                                        enabled: track.index > 0;
                                        accessible-label: "Move " + track.title + " up in playlist";
                                        clicked => root.move-playlist-entry(root.opened-playlist-id, track.index, track.playlist-position, track.id, -1);
                                    }
                                    ArchiveButton {
                                        text: "Down";
                                        enabled: track.index + 1 < root.track-result-count;
                                        accessible-label: "Move " + track.title + " down in playlist";
                                        clicked => root.move-playlist-entry(root.opened-playlist-id, track.index, track.playlist-position, track.id, 1);
                                    }
                                    ArchiveButton {
                                        text: "Remove";
                                        accessible-label: "Remove " + track.title + " occurrence from playlist";
                                        clicked => root.remove-playlist-entry(root.opened-playlist-id, track.index, track.playlist-position, track.id);
                                    }
                                }
                            }
                        }
                    }

                    if root.current-view == "music" && root.music-section == "playlists" && root.music-detail-open: VerticalLayout {
                        height: 72px;
                        spacing: 4px;
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            ArchiveButton { text: "Back to playlists"; clicked => root.back-music-detail(); }
                            Text { text: root.opened-playlist-name; color: #ffffff; font-weight: 650; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            ArchiveButton { text: "Play all"; enabled: root.visible-count > 0; primary: true; clicked => root.play-all-collection(); }
                            ArchiveButton { text: "Shuffle stored order"; enabled: root.can-shuffle-opened-playlist; clicked => root.shuffle-opened-playlist(); }
                            ArchiveButton { text: "Export M3U8"; accessible-label: "Export " + root.opened-playlist-name + " as an M3U8 playlist"; clicked => root.export-m3u8(root.opened-playlist-id); }
                            ArchiveButton {
                                text: root.confirm-delete-playlist ? "Confirm delete" : "Delete";
                                accessible-label: root.confirm-delete-playlist ? "Confirm deleting playlist" : "Delete playlist";
                                clicked => {
                                    if root.confirm-delete-playlist {
                                        root.delete-playlist(root.opened-playlist-id);
                                        root.confirm-delete-playlist = false;
                                    } else {
                                        root.confirm-delete-playlist = true;
                                    }
                                }
                            }
                            if root.confirm-delete-playlist: ArchiveButton {
                                text: "Cancel";
                                clicked => { root.confirm-delete-playlist = false; }
                            }
                        }
                        HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            Text { text: "Rename"; color: #ffffffB3; vertical-alignment: center; }
                            ArchiveLineEdit {
                                horizontal-stretch: 1;
                                text <=> root.playlist-rename-input;
                                placeholder-text: "Playlist name";
                                accessible-label: "Rename opened playlist";
                                edited(text) => root.playlist-rename-input-changed(text);
                            }
                            ArchiveButton {
                                text: "Save name";
                                enabled: root.playlist-rename-input != "";
                                clicked => root.rename-opened-playlist(root.opened-playlist-id, root.playlist-rename-input);
                            }
                        }
                    }

                    if root.current-view == "music" && root.music-detail-open && root.music-section != "playlists": HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        ArchiveButton { text: "Back"; clicked => root.back-music-detail(); }
                        Text { text: root.music-detail-title; color: #ffffff; font-weight: 650; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ArchiveButton { text: "Play all"; enabled: root.visible-count > 0; primary: true; clicked => root.play-all-collection(); }
                    }

                    if root.current-view == "music" && (root.music-section == "tracks" || root.music-detail-open) && root.visible-count == 0: Rectangle {
                        vertical-stretch: 1;
                        background: #1b1917;
                        border-radius: 8px;
                        VerticalLayout { alignment: center; spacing: 8px; Text { text: "No tracks match this collection and search."; color: #ffffffB3; horizontal-alignment: center; } if root.search-query != "" || root.music-genre != "All genres" || (root.music-sort != "Recently added" && !(root.music-section == "albums" && root.music-detail-open && root.music-sort == "Disc / track")): ArchiveButton { text: "Clear filters"; style: "plain"; clicked => root.clear-music-filters(); } }
                    }

                    if root.current-view == "movies" && !root.has-movies: Rectangle {
                        vertical-stretch: 1;
                        background: #1b1917;
                        border-color: #3b3631;
                        border-width: 1px;
                        border-radius: 8px;
                        VerticalLayout {
                            padding: 28px;
                            spacing: 12px;
                            Text { text: "Your movie library is empty"; color: #ffffff; font-size: 22px; font-weight: 700; }
                            Text { text: "Import a folder or add local movies. Local details and nearby posters are read on this device."; color: #ffffffB3; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 36px;
                                ArchiveButton { width: 220px; height: 36px; text: "Add local movies"; primary: true; clicked => root.open-movie-files(); }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    if root.current-view == "movies" && root.has-movies && root.movie-level != "episodes" && root.has-movie-cards: ScrollView {
                        vertical-stretch: 1;
                        content-width: self.width;
                        FlexboxLayout {
                            width: parent.width;
                            spacing: 18px;
                            flex-direction: row;
                            flex-wrap: wrap;
                            for card in root.movie-cards: VerticalLayout {
                                width: root.poster-card-width;
                                height: root.poster-card-width * 3 / 2 + 83px;
                                spacing: 3px;
                                Rectangle {
                                    width: parent.width;
                                    height: parent.width * 3 / 2;
                                    clip: true;
                                    if card.has-artwork: Image { width: parent.width; height: parent.height; source: card.artwork; image-fit: cover; accessible-label: card.title + " poster"; }
                                    if !card.has-artwork: Rectangle { width: parent.width; height: parent.height; background: #302820; Text { text: card.monogram; color: #f46b32; font-size: 44px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                                    TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        accessible-role: button;
                                        accessible-label: (card.kind == "movie" ? "View details for " : "Browse ") + card.title;
                                        clicked => {
                                            if (card.kind == "movie") { root.movie-poster-clicked(card.id); }
                                            else { root.open-movie-group(card.id); }
                                        }
                                        double-clicked => { if (card.kind != "movie") { root.open-movie-group(card.id); } }
                                    }
                                }
                                ArchiveButton {
                                    width: parent.width;
                                    height: 23px;
                                    style: "plain";
                                    text: card.title;
                                    accessible-label: (card.kind == "movie" ? "View details for " : "Browse ") + card.title;
                                    clicked => {
                                        if (card.kind == "movie") { root.select-movie(card.id); }
                                        else { root.open-movie-group(card.id); }
                                    }
                                }
                                Text {
                                    text: card.kind == "movie"
                                        ? (card.year == "" ? card.detail : card.year + (card.genre == "" ? "" : "  ·  " + card.genre))
                                        : card.detail;
                                    color: #ffffffB3;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                                if card.progress-label != "": Text { text: card.progress-label; color: #aaa196; font-size: 9px; overflow: elide; }
                                if card.kind == "movie": ArchiveButton {
                                    width: parent.width;
                                    height: 22px;
                                    style: "plain";
                                    text: card.saved ? "✓ In My List" : "+ Add to My List";
                                    accessible-label: card.saved ? "Remove " + card.title + " from My List" : "Add " + card.title + " to My List";
                                    clicked => root.toggle-saved-movie(card.id);
                                }
                            }
                        }
                    }

                    if root.current-view == "movies" && root.has-movies && root.movie-level == "episodes" && root.movie-episodes.length > 0: ListView {
                        vertical-stretch: 1;
                        accessible-role: list;
                        for movie in root.movie-episodes: Rectangle {
                            height: 64px;
                            background: #1b1917;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                if movie.has-artwork: Image { width: 46px; height: 48px; source: movie.artwork; image-fit: cover; accessible-label: movie.title + " poster"; }
                                if !movie.has-artwork: Rectangle { width: 46px; height: 48px; background: #302820; Text { text: movie.monogram; color: #f46b32; horizontal-alignment: center; vertical-alignment: center; font-weight: 700; } }
                                TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => root.movie-poster-clicked(movie.id);
                                    VerticalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        alignment: center;
                                        spacing: 3px;
                                        Text { text: movie.title; color: #ffffff; font-weight: 650; overflow: elide; }
                                        Text { text: movie.progress-label == "" ? movie.detail : movie.progress-label; color: #ffffffB3; font-size: 10px; overflow: elide; }
                                    }
                                }
                                if movie.can-resume: ArchiveButton { text: "Resume"; clicked => root.play-movie(movie.id, true); }
                                ArchiveButton { text: "Start over"; primary: true; clicked => root.play-movie(movie.id, false); }
                                if movie.local-media: ArchiveButton { text: "Locate file"; accessible-label: "Choose a replacement file for " + movie.title; clicked => root.relink-media(movie.id); }
                            }
                        }
                    }

                    if root.current-view == "movies" && root.has-movies && !root.has-movie-cards && root.movie-level != "episodes": VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text { text: "No movies match this search and filter."; color: #ffffffB3; horizontal-alignment: center; }
                        if root.search-query != "" || root.movie-view != "all" || root.movie-genre != "All genres" || root.movie-filter != "all" || root.movie-sort != "Recently added": ArchiveButton { text: "Clear filters"; style: "plain"; clicked => root.clear-movie-filters(); }
                    }

                    if root.current-view == "movies" && root.has-movies && root.movie-level == "episodes" && root.movie-episodes.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Text { text: "No episodes match this search and filter."; color: #ffffffB3; horizontal-alignment: center; }
                        if root.search-query != "" || root.movie-view != "all" || root.movie-genre != "All genres" || root.movie-filter != "all" || root.movie-sort != "Recently added": ArchiveButton { text: "Clear filters"; style: "plain"; clicked => root.clear-movie-filters(); }
                    }

                    HorizontalLayout {
                        height: 27px;
                        spacing: 10px;
                        ArchiveButton { text: "Previous page"; enabled: root.page-index > 0; clicked => root.previous-page(); }
                        Text { text: "Page " + (root.page-index + 1) + " of " + root.page-count; color: #ffffffB3; vertical-alignment: center; }
                        ArchiveButton { text: "Next page"; enabled: root.page-index + 1 < root.page-count; clicked => root.next-page(); }
                        Rectangle { horizontal-stretch: 1; }
                        if root.artwork-target-ready: Text { text: "Artwork: " + root.artwork-target-title; color: #ffffffB3; font-size: 10px; overflow: elide; }
                        if root.artwork-target-ready: ArchiveButton { text: "Retry local art"; enabled: root.artwork-target-missing; clicked => root.retry-local-artwork(); }
                        if root.artwork-target-ready: ArchiveButton { text: root.artwork-target-video ? "Choose poster" : "Find artwork online"; primary: true; clicked => root.find-online-artwork(); }
                    }

                    if root.status-message != "": Text { height: 18px; text: root.status-message; color: #ffffff; font-size: 11px; wrap: word-wrap; overflow: elide; }
                }
            }

            if root.movie-fullscreen: Rectangle {
                vertical-stretch: 1;
                background: #080808;
                clip: true;
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.video-frame; image-fit: root.video-fill ? cover : contain; }
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    moved => root.fullscreen-activity();
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down || event.kind == PointerEventKind.up {
                            root.fullscreen-activity();
                        }
                    }
                }
                if !root.has-video-frame: Text { x: 32px; y: 24px; width: parent.width - 64px; height: parent.height - 48px; text: root.player-state == "Playback error" ? root.status-message : "Opening " + root.current-title + "…"; color: #ffffffB3; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                fullscreen-transport-scope := FocusScope {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 172px;
                    height: 52px;
                    visible: root.fullscreen-controls-visible || self.has-focus;
                    HorizontalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 12px;
                        ArchiveButton { width: 48px; height: 48px; style: "icon"; text: "|<"; accessible-label: "Previous movie"; enabled: root.has-current-track; space-activates: false; pointer-moved => root.fullscreen-activity(); clicked => { root.fullscreen-activity(); root.previous(); } }
                        ArchiveButton {
                            width: 48px;
                            height: 48px;
                            style: "icon";
                            text: root.player-state == "Finished" ? "↻" : root.is-paused || root.player-state == "Ready" ? "▶" : "Ⅱ";
                            accessible-label: root.player-state == "Finished" ? "Replay movie" : root.is-paused || root.player-state == "Ready" ? "Play movie" : "Pause movie";
                            enabled: root.can-toggle-pause;
                            pointer-moved => root.fullscreen-activity();
                            clicked => { root.fullscreen-activity(); root.toggle-pause(); }
                        }
                        ArchiveButton { width: 48px; height: 48px; style: "icon"; text: ">|"; accessible-label: "Next movie"; enabled: root.has-current-track; space-activates: false; pointer-moved => root.fullscreen-activity(); clicked => { root.fullscreen-activity(); root.next(); } }
                    }
                }
            }

            if root.queue-open && !root.movie-fullscreen: Rectangle {
                height: 148px;
                background: #1b1917;
                border-color: #3b3631;
                border-width: 1px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;
                    HorizontalLayout {
                        height: 24px;
                        Text { text: "PLAY QUEUE"; color: #ffffff; font-size: 10px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.queue-position; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                        ArchiveButton { text: "Repeat " + root.repeat-mode; clicked => root.cycle-repeat-mode(); }
                        ArchiveCheckBox { text: "Shuffle playback"; checked <=> root.playback-shuffle; toggled => root.playback-shuffle-changed(self.checked); }
                    }
                    ListView {
                        vertical-stretch: 1;
                        accessible-role: list;
                        for queued in root.queue-rows: Rectangle {
                            height: 32px;
                            background: #211e1b;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 5px;
                                ArchiveButton { horizontal-stretch: 1; text: (queued.position + 1) + ".  " + queued.title; clicked => root.queue-jump(queued.revision, queued.position); }
                                ArchiveButton { text: "Up"; enabled: queued.position > 0; clicked => root.queue-move(queued.revision, queued.position, queued.position - 1); }
                                ArchiveButton { text: "Down"; enabled: queued.position + 1 < root.queue-rows.length; clicked => root.queue-move(queued.revision, queued.position, queued.position + 1); }
                                ArchiveButton { text: "Remove"; clicked => root.queue-remove(queued.revision, queued.position); }
                            }
                        }
                    }
                }
            }

            if root.tools-open && !root.movie-fullscreen: Rectangle {
                height: 300px;
                background: #1b1917;
                border-color: #3b3631;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 5px;
                    HorizontalLayout {
                        height: 26px;
                        spacing: 8px;
                        Text { text: root.has-current-track ? (root.playing-video ? "▣  MOVIE" : "♫  MUSIC") : "TOOLS"; color: #f46b32; font-size: 10px; font-weight: 700; vertical-alignment: center; accessible-label: root.has-current-track ? (root.playing-video ? "Movie" : "Music") : "Player tools"; }
                        Text { text: root.has-current-track ? root.source-title : "No media loaded"; color: #ffffff; font-size: 12px; font-weight: 650; horizontal-stretch: 1; overflow: elide; accessible-label: root.has-current-track ? root.source-title + (root.source-kind == "Network stream" ? ", network stream " : ", local file ") + root.source-path : "No media loaded. Open a stream or import a playlist."; }
                        Text { text: root.has-current-track ? root.source-kind : "Ready for media"; color: #ffffff78; font-size: 9px; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        height: 30px;
                        spacing: 3px;
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Media"; primary: root.tools-tab == "Media"; clicked => { root.tools-tab = "Media"; } }
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Equalizer"; primary: root.tools-tab == "Equalizer"; clicked => { root.tools-tab = "Equalizer"; } }
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Time"; primary: root.tools-tab == "Time"; clicked => { root.tools-tab = "Time"; } }
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Bookmarks"; primary: root.tools-tab == "Bookmarks"; clicked => { root.tools-tab = "Bookmarks"; } }
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Stream"; primary: root.tools-tab == "Stream"; clicked => { root.tools-tab = "Stream"; } }
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Subtitles"; primary: root.tools-tab == "Subtitles"; clicked => { root.tools-tab = "Subtitles"; } }
                        ArchiveButton { horizontal-stretch: 1; style: "tab"; text: "Playlist"; primary: root.tools-tab == "Playlist"; clicked => { root.tools-tab = "Playlist"; } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.width;
                        if root.tools-tab == "Media": HorizontalLayout {
                            width: parent.width;
                            height: 190px;
                            spacing: 8px;
                            alignment: center;
                            VerticalLayout {
                                width: 136px;
                                Text { text: "♫  Audio"; color: #ffffff; font-size: 11px; font-weight: 650; }
                                if root.audio-tracks.length == 0: Text { text: root.has-current-track ? "No audio tracks" : "Load or play media to choose audio tracks."; height: 32px; color: #ffffff78; font-size: 10px; vertical-alignment: center; wrap: word-wrap; }
                                if root.audio-tracks.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for choice in root.audio-tracks: Rectangle {
                                        height: 24px;
                                        ArchiveButton { width: parent.width; height: parent.height; text: choice.title; enabled: root.has-current-track; clicked => root.select-audio-track(root.current-track-id, choice.id); }
                                    }
                                }
                            }
                            Rectangle { width: 1px; height: 150px; background: #3b3631; }
                            VerticalLayout {
                                width: 150px;
                                Text { text: "CC  Subtitles"; color: #ffffff; font-size: 11px; font-weight: 650; }
                                ArchiveButton { width: parent.width; height: 24px; text: "⊘ Off"; accessible-label: "Turn subtitles off"; enabled: root.has-current-track; clicked => root.select-subtitle-track(root.current-track-id, -1); }
                                if root.subtitle-tracks.length == 0: Text { text: root.has-current-track ? "No subtitle tracks" : "Load media to choose subtitles."; height: 32px; color: #ffffff78; font-size: 10px; vertical-alignment: center; wrap: word-wrap; }
                                if root.subtitle-tracks.length > 0: ListView {
                                    vertical-stretch: 1;
                                    for choice in root.subtitle-tracks: Rectangle {
                                        height: 24px;
                                        ArchiveButton { width: parent.width; height: parent.height; text: choice.title; enabled: root.has-current-track; clicked => root.select-subtitle-track(root.current-track-id, choice.id); }
                                    }
                                }
                            }
                            if root.chapters.length > 0: Rectangle { width: 1px; height: 150px; background: #3b3631; }
                            if root.chapters.length > 0: VerticalLayout {
                                width: 130px;
                                Text { text: "▤  Chapters"; color: #ffffff; font-size: 11px; font-weight: 650; }
                                ListView {
                                    vertical-stretch: 1;
                                    for chapter in root.chapters: Rectangle {
                                        height: 24px;
                                        ArchiveButton { width: parent.width; height: parent.height; text: chapter.title; enabled: root.has-current-track; clicked => root.select-chapter(root.current-track-id, chapter.id); }
                                    }
                                }
                            }
                            if root.chapters.length > 0: Rectangle { width: 1px; height: 150px; background: #3b3631; }
                            VerticalLayout {
                                width: 350px;
                                Text { text: "⏱  Sync & playback"; color: #ffffff; font-size: 11px; font-weight: 650; }
                                HorizontalLayout {
                                    spacing: 5px;
                                    Text { width: 42px; text: "Audio"; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                    ArchiveLineEdit { width: 68px; text <=> root.audio-delay-input; enabled: root.has-current-track; placeholder-text: "0"; edited(text) => root.audio-delay-draft-changed(text); accessible-label: "Audio delay in milliseconds"; }
                                    Text { width: 18px; text: "ms"; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                    ArchiveButton { width: 48px; height: 32px; style: "icon"; text: "✓"; accessible-label: "Apply audio delay"; enabled: root.has-current-track; clicked => root.audio-delay-changed(root.audio-delay-input); }
                                    ArchiveButton { width: 48px; height: 32px; style: "icon"; text: "↺"; accessible-label: "Reset audio delay"; enabled: root.has-current-track; clicked => root.audio-delay-changed("0"); }
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    Text { width: 42px; text: "Subs"; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                    ArchiveLineEdit { width: 68px; text <=> root.subtitle-delay-input; enabled: root.has-current-track; placeholder-text: "0"; edited(text) => root.subtitle-delay-draft-changed(text); accessible-label: "Subtitle delay in milliseconds"; }
                                    Text { width: 18px; text: "ms"; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                    ArchiveButton { width: 48px; height: 32px; style: "icon"; text: "✓"; accessible-label: "Apply subtitle delay"; enabled: root.has-current-track; clicked => root.subtitle-delay-changed(root.subtitle-delay-input); }
                                    ArchiveButton { width: 48px; height: 32px; style: "icon"; text: "↺"; accessible-label: "Reset subtitle delay"; enabled: root.has-current-track; clicked => root.subtitle-delay-changed("0"); }
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    ArchiveLineEdit { width: 102px; text <=> root.jump-time-input; enabled: root.can-seek; placeholder-text: "hh:mm:ss"; edited(text) => root.jump-time-changed(text); accessible-label: "Jump to time"; }
                                    ArchiveButton { width: 62px; text: "↪ Jump"; accessible-label: "Jump to time"; enabled: root.can-seek; primary: true; clicked => root.jump-to-time(); }
                                    ArchiveButton { width: 54px; text: root.video-fill ? "Fit" : "Fill"; visible: root.playing-video; accessible-label: root.video-fill ? "Fit video to screen" : "Fill screen with video"; clicked => root.set-video-fill(!root.video-fill); }
                                    ArchiveButton { width: 88px; text: "⊕ CC"; accessible-label: "Add subtitle file"; enabled: root.has-current-track && root.playing-video; clicked => root.add-subtitle-file(); }
                                }
                            }
                        }
                        if root.tools-tab == "Equalizer": VerticalLayout {
                            width: parent.width;
                            height: 350px;
                            padding: 6px;
                            spacing: 8px;
                            HorizontalLayout {
                                height: 34px;
                                ArchiveCheckBox { text: "Enable equalizer"; checked: root.equalizer-enabled; enabled: root.runtime-available && root.equalizer-bands.length > 0; toggled => root.equalizer-enabled-changed(self.checked); }
                                Text { text: "PRESET"; color: #ffffffB3; font-size: 9px; vertical-alignment: center; }
                                ArchiveComboBox {
                                    width: 220px;
                                    model: root.equalizer-presets;
                                    current-value <=> root.equalizer-preset;
                                    enabled: root.runtime-available && root.equalizer-presets.length > 0;
                                    accessible-label: "Equalizer preset supplied by VLC";
                                    selected(value) => root.equalizer-preset-changed(value);
                                }
                            }
                            HorizontalLayout {
                                height: 34px;
                                Text { width: 65px; text: "Preamp"; color: #ffffff; vertical-alignment: center; }
                                SeekSlider {
                                    horizontal-stretch: 1;
                                    minimum: -20;
                                    maximum: 20;
                                    step: 0.5;
                                    keyboard-step: 0.5;
                                    value: root.equalizer-preamp-db;
                                    enabled: root.equalizer-enabled && root.runtime-available;
                                    seek-label: "Equalizer preamp gain in decibels";
                                    changed(value) => root.equalizer-preamp-draft-changed(value);
                                    released(value) => root.equalizer-preamp-changed(value);
                                    cancelled => root.equalizer-preamp-cancelled();
                                }
                                Text { width: 66px; text: root.equalizer-preamp-label; color: #ffffffB3; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
                            }
                            if root.equalizer-bands.length == 0: Text { height: 34px; text: "The current VLC runtime did not report equalizer band frequencies."; color: #ffffffB3; wrap: word-wrap; vertical-alignment: center; }
                            if root.equalizer-bands.length > 0: ListView {
                                vertical-stretch: 1;
                                accessible-role: list;
                                for band in root.equalizer-bands: Rectangle {
                                    height: 30px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { width: 72px; text: band.frequency; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                        SeekSlider {
                                            horizontal-stretch: 1;
                                            minimum: -20;
                                            maximum: 20;
                                            step: 0.5;
                                            keyboard-step: 0.5;
                                            value: band.gain;
                                            enabled: root.equalizer-enabled && root.runtime-available;
                                            seek-label: "Equalizer gain at " + band.frequency;
                                            changed(value) => root.equalizer-band-draft-changed(band.index, value);
                                            released(value) => root.equalizer-band-changed(band.index, value);
                                            cancelled => root.equalizer-band-cancelled();
                                        }
                                        Text { width: 66px; text: band.gain-label; color: #ffffffB3; font-size: 10px; vertical-alignment: center; horizontal-alignment: right; }
                                    }
                                }
                            }
                        }
                        if root.tools-tab == "Time": VerticalLayout {
                            width: parent.width;
                            height: 150px;
                            padding: 8px;
                            spacing: 10px;
                            Text { text: "A/B loop"; color: #f46b32; font-size: 12px; font-weight: 700; }
                            if !root.has-current-track: Text { text: "Load or play media to set a loop or jump to a time."; color: #ffffff78; font-size: 10px; wrap: word-wrap; }
                            Text { text: root.ab-repeat-label; color: #ffffffB3; font-size: 11px; }
                            HorizontalLayout {
                                spacing: 8px;
                                ArchiveButton { text: "Set A here"; enabled: root.can-set-ab-repeat; accessible-label: "Set loop start at the current position"; clicked => root.set-ab-repeat-point("A", root.current-track-id, root.current-load-generation); }
                                ArchiveButton { text: "Set B here"; enabled: root.can-set-ab-repeat; accessible-label: "Set loop end at the current position"; clicked => root.set-ab-repeat-point("B", root.current-track-id, root.current-load-generation); }
                                ArchiveButton { text: "Clear loop"; enabled: root.has-ab-repeat && root.can-set-ab-repeat; clicked => root.clear-ab-repeat(root.current-track-id, root.current-load-generation); }
                            }
                            Rectangle { height: 1px; background: #3b3631; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: root.sleep-timer-label; color: #ffffff; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                                ArchiveButton { text: "15 min"; enabled: root.runtime-available && root.has-current-track; clicked => root.set-sleep-timer(15); }
                                ArchiveButton { text: "30 min"; enabled: root.runtime-available && root.has-current-track; clicked => root.set-sleep-timer(30); }
                                ArchiveButton { text: "60 min"; enabled: root.runtime-available && root.has-current-track; clicked => root.set-sleep-timer(60); }
                                ArchiveButton { text: "Cancel"; enabled: root.sleep-timer-label != "Sleep timer off"; clicked => root.set-sleep-timer(0); }
                            }
                            Text { text: "The timer is temporary and stops playback when it expires."; color: #ffffff78; font-size: 10px; wrap: word-wrap; }
                        }
                        if root.tools-tab == "Bookmarks": VerticalLayout {
                            width: parent.width;
                            height: 230px;
                            padding: 8px;
                            spacing: 8px;
                            Text { text: root.has-current-track ? "Bookmarks for " + root.current-title : "Bookmarks"; color: #ffffff; font-size: 12px; font-weight: 650; overflow: elide; }
                            if !root.has-current-track: Text { text: "Load media to save or jump to its bookmarks."; color: #ffffff78; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                ArchiveLineEdit { horizontal-stretch: 1; text <=> root.bookmark-name-input; enabled: root.has-current-track; placeholder-text: "Name this point (optional)"; edited(text) => root.bookmark-name-changed(text); accessible-label: "Optional bookmark name"; }
                                ArchiveButton { text: "Save current point"; primary: true; enabled: root.has-current-track; clicked => root.add-bookmark(); }
                            }
                            if root.bookmarks.length == 0: Text { height: 32px; text: root.has-current-track ? "No bookmarks for this media yet." : "No media is selected."; color: #ffffff78; vertical-alignment: center; }
                            if root.bookmarks.length > 0: ListView {
                                vertical-stretch: 1;
                                accessible-role: list;
                                for bookmark in root.bookmarks: Rectangle {
                                    height: 34px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: bookmark.name; color: #ffffff; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                        Text { text: bookmark.time; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                        ArchiveButton { text: "Jump"; enabled: root.has-current-track; accessible-label: "Jump to bookmark " + bookmark.name; clicked => root.bookmark-jump(bookmark.index); }
                                        ArchiveButton { text: "Remove"; enabled: root.has-current-track; accessible-label: "Remove bookmark " + bookmark.name; clicked => root.remove-bookmark(bookmark.index); }
                                    }
                                }
                            }
                        }
                        if root.tools-tab == "Stream": VerticalLayout {
                            width: parent.width;
                            height: 400px;
                            padding: 8px;
                            spacing: 8px;
                            Text { text: "Cast target"; color: #f46b32; font-size: 12px; font-weight: 700; }
                            Text { text: "Current output: " + root.cast-target-label; color: #ffffffB3; font-size: 10px; overflow: elide; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                ArchiveLineEdit { horizontal-stretch: 1; text <=> root.cast-address-input; placeholder-text: "Device IP or hostname"; edited(text) => root.cast-address-draft-changed(text); accessible-label: "Chromecast target IP address or hostname"; }
                                ArchiveButton { text: "Connect"; enabled: root.cast-address-input != "" && root.runtime-available; primary: true; clicked => root.set-cast-target(root.cast-address-input); }
                                ArchiveButton { text: "Use local"; enabled: root.cast-target-label != "Local output"; clicked => root.use-local-output(); }
                            }
                            Rectangle { height: 1px; background: #3b3631; }
                            Text { text: "Network media"; color: #f46b32; font-size: 12px; font-weight: 700; }
                            Text { text: "Enter an HTTP, HTTPS, RTSP or RTMP address. Credentials in the URL are rejected; signed query text is hidden in history."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                ArchiveLineEdit { horizontal-stretch: 1; text <=> root.network-url-input; placeholder-text: "https://example.test/movie.m3u8"; edited(text) => root.network-url-input-changed(text); accessible-label: "Network media URL without embedded username or password"; }
                                ArchiveButton { text: "Play video"; primary: true; enabled: root.network-url-input != ""; clicked => root.play-network-url(false); }
                                ArchiveButton { text: "Play audio"; enabled: root.network-url-input != ""; clicked => root.play-network-url(true); }
                            }
                            Text { text: "Recent network media"; color: #ffffff; font-size: 11px; font-weight: 650; }
                            if root.network-history.length == 0: Text { height: 32px; text: "Played network media will appear here."; color: #ffffff78; vertical-alignment: center; }
                            if root.network-history.length > 0: ListView {
                                vertical-stretch: 1;
                                accessible-role: list;
                                for entry in root.network-history: Rectangle {
                                    height: 48px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text { text: entry.title; color: #ffffff; font-size: 10px; overflow: elide; }
                                            Text { text: entry.address; color: #ffffffB3; font-size: 9px; overflow: elide; accessible-label: "Redacted address " + entry.address; }
                                        }
                                        Text { width: 56px; text: entry.played; color: #ffffff78; font-size: 9px; vertical-alignment: center; }
                                        ArchiveButton { text: "Play"; accessible-label: "Play network media " + entry.title; clicked => root.open-network-history(entry.index); }
                                        ArchiveButton { text: "Remove"; accessible-label: "Remove " + entry.title + " from network history"; clicked => root.remove-network-history(entry.index); }
                                    }
                                }
                            }
                        }
                        if root.tools-tab == "Subtitles": VerticalLayout {
                            width: parent.width;
                            height: 330px;
                            padding: 8px;
                            spacing: 8px;
                            Text { text: root.has-current-track ? "Find subtitles for " + root.current-title : "Find subtitles"; color: #ffffff; font-size: 12px; font-weight: 650; overflow: elide; }
                            if !root.has-current-track: Text { text: "Load a movie to search and attach subtitles."; color: #ffffff78; font-size: 10px; wrap: word-wrap; }
                            Text { text: "Search sends the title and language codes only. Downloaded SRT files go to the application cache and attach only to the same media load."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Text { text: "Languages"; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                                ArchiveLineEdit { width: 160px; text <=> root.subtitle-language-input; placeholder-text: "en,fr"; edited(text) => root.subtitle-languages-changed(text); accessible-label: "Subtitle language codes, comma separated"; }
                                ArchiveButton { text: "Search subtitles"; primary: true; enabled: root.playing-video; clicked => root.search-subtitles(root.subtitle-language-input); }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.subtitle-search-status != "": Text { height: 28px; text: root.subtitle-search-status; color: #ffffffB3; font-size: 10px; wrap: word-wrap; vertical-alignment: center; }
                            if root.subtitle-results.length == 0: Text { vertical-stretch: 1; text: root.opensubtitles-credentials-available ? "Search for matching subtitles. OpenSubtitles errors appear here." : "Add an OpenSubtitles API key in Options before searching."; color: #ffffff78; font-size: 10px; vertical-alignment: center; horizontal-alignment: center; wrap: word-wrap; }
                            if root.subtitle-results.length > 0: ListView {
                                vertical-stretch: 1;
                                accessible-role: list;
                                for result in root.subtitle-results: Rectangle {
                                    height: 44px;
                                    background: #211e1b;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text { text: result.title; color: #ffffff; font-size: 10px; overflow: elide; }
                                            Text { text: result.detail; color: #ffffff78; font-size: 9px; overflow: elide; }
                                        }
                                        ArchiveButton { text: "Download & attach"; enabled: root.opensubtitles-credentials-available && root.playing-video; accessible-label: "Download and attach subtitle " + result.title; clicked => root.download-subtitle(result.index); }
                                    }
                                }
                            }
                        }
                        if root.tools-tab == "Playlist": VerticalLayout {
                            width: parent.width;
                            height: 180px;
                            padding: 8px;
                            spacing: 8px;
                            Text { text: "M3U8 playlists"; color: #f46b32; font-size: 12px; font-weight: 700; }
                            Text { text: "Import preserves entry order and repeats. Export writes playlist references only; source media is never copied or modified."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                            HorizontalLayout {
                                height: 36px;
                                spacing: 8px;
                                ArchiveButton { text: "Import M3U8"; primary: true; clicked => root.import-m3u8(); }
                                ArchiveButton { text: "Export opened playlist"; enabled: root.opened-playlist-id >= 0; clicked => root.export-m3u8(root.opened-playlist-id); }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text { text: root.playlist-io-status; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                        }
                    }
                }
            }

            if root.has-current-track && !root.movie-fullscreen: Rectangle {
                height: 82px;
                background: #211e1b;
                border-color: #3b3631;
                border-width: 1px;
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 3px;
                    HorizontalLayout {
                        height: 34px;
                        spacing: 8px;
                        VerticalLayout {
                            min-width: 160px;
                            max-width: 300px;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text { text: root.current-title; color: #ffffff; font-size: 14px; font-weight: 650; overflow: elide; }
                            Text { text: root.player-state + "  ·  " + root.queue-position; color: #ffffffB3; font-size: 9px; overflow: elide; }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: center;
                            ArchiveButton { width: 42px; height: 38px; style: "icon"; text: "|<"; accessible-label: "Previous media"; enabled: root.has-current-track; space-activates: false; clicked => root.previous(); }
                            ArchiveButton { width: 48px; height: 38px; style: "icon"; text: root.player-state == "Finished" ? "↻" : root.is-paused || root.player-state == "Idle" || root.player-state == "Ready" ? "▶" : "Ⅱ"; accessible-label: root.player-state == "Finished" ? "Replay" : root.is-paused || root.player-state == "Idle" || root.player-state == "Ready" ? "Play" : "Pause"; enabled: root.can-toggle-pause; primary: true; clicked => root.toggle-pause(); }
                            ArchiveButton { width: 42px; height: 38px; style: "icon"; text: ">|"; accessible-label: "Next media"; enabled: root.has-current-track; space-activates: false; clicked => root.next(); }
                        }
                        ArchiveButton { width: 42px; height: 38px; style: "icon"; text: "■"; accessible-label: "Stop playback"; enabled: root.can-stop; space-activates: false; clicked => root.stop(); }
                        if root.can-return-to-video: ArchiveButton { width: 112px; height: 34px; text: "Return to video"; accessible-label: "Return to video fullscreen (F)"; clicked => root.return-to-video(); }
                        if root.playing-video: ArchiveButton { width: 88px; height: 34px; text: "▣ Screenshot"; accessible-label: "Save the current video frame as a PNG image"; enabled: root.has-video-frame; clicked => root.save-video-frame(); }
                        if root.playing-video: ArchiveButton { width: 68px; height: 34px; text: root.picture-in-picture-open ? "Close PiP" : "PiP"; accessible-label: root.picture-in-picture-open ? "Close picture-in-picture window" : "Open picture-in-picture window (P)"; enabled: root.has-video-frame || root.picture-in-picture-open; clicked => { if (root.picture-in-picture-open) { root.close-picture-in-picture(); } else { root.open-picture-in-picture(); } } }
                    }
                    HorizontalLayout {
                        height: 24px;
                        spacing: 7px;
                        Text { text: root.player-time; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                        SeekSlider {
                            horizontal-stretch: 1;
                            minimum: 0;
                            maximum: root.player-duration-ms;
                            step: 1000;
                            keyboard-step: 10000;
                            value <=> root.player-position-ms;
                            enabled: root.can-seek;
                            current-track-id: root.current-track-id;
                            current-load-generation: root.current-load-generation;
                            seek-label: "Seek playback position";
                            changed(value, track-id, load-generation) => {
                                root.adjusting-seek = true;
                                root.seek-changed(value, track-id, load-generation, false);
                            }
                            released(value, track-id, load-generation) => {
                                root.adjusting-seek = false;
                                root.seek-changed(value, track-id, load-generation, true);
                            }
                            cancelled => { root.adjusting-seek = false; }
                        }
                        Text { text: root.player-duration; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                        Text { text: "Vol " + root.player-volume-label; color: #ffffffB3; font-size: 9px; vertical-alignment: center; }
                        SeekSlider {
                            width: 110px;
                            minimum: 0;
                            maximum: 100;
                            step: 1;
                            value <=> root.player-volume;
                            enabled: root.can-adjust-playback;
                            seek-label: "Playback volume";
                            changed(value, track-id, load-generation) => { root.adjusting-volume = true; root.volume-changed(value, false); }
                            released(value, track-id, load-generation) => { root.adjusting-volume = false; root.volume-changed(value, true); }
                            cancelled => { root.adjusting-volume = false; }
                        }
                        Text { text: "Speed " + root.playback-rate-label; color: #ffffffB3; font-size: 9px; vertical-alignment: center; }
                        SeekSlider {
                            width: 110px;
                            minimum: 0.25;
                            maximum: 4;
                            step: 0.25;
                            value <=> root.playback-rate;
                            enabled: root.can-adjust-playback;
                            seek-label: "Playback speed";
                            changed(value, track-id, load-generation) => { root.adjusting-rate = true; root.playback-rate-changed(value, false); }
                            released(value, track-id, load-generation) => { root.adjusting-rate = false; root.playback-rate-changed(value, true); }
                            cancelled => { root.adjusting-rate = false; }
                        }
                    }
                }
            }
        }

        if root.about-open: Rectangle {
            x: max(18px, parent.width - self.width - 24px);
            y: 72px;
            width: 430px;
            height: 450px;
            background: #211e1b;
            border-color: #5a392a;
            border-width: 1px;
            border-radius: 8px;
            VerticalLayout {
                padding: 18px;
                spacing: 9px;
                HorizontalLayout {
                    Text { text: "About Première"; color: #ffffff; font-size: 20px; font-weight: 700; horizontal-stretch: 1; }
                    ArchiveButton { text: "Close"; clicked => { root.about-open = false; } }
                }
                Text { text: "Version " + root.app-version; color: #f46b32; font-size: 12px; font-weight: 650; }
                Text { text: "A local-first desktop media library. Native media paths and playback history stay on this device."; color: #ffffff; font-size: 11px; wrap: word-wrap; }
                Text { text: "With a TMDB token saved, missing genres for local movies and TV are looked up automatically using title and year when available. Poster searches require your choice. Music tags and art are read locally; if art is missing, online lookup sends the track title and artist to YouTube, then the fallback may send the album tag to MusicBrainz and download artwork from Cover Art Archive. Native media paths are never sent."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                Image { width: 85px; height: 62px; source: @image-url("../assets/attribution/tmdb-logo.png"); image-fit: contain; accessible-label: "TMDB logo"; }
                Text { text: "This product uses the TMDB API but is not endorsed or certified by TMDB."; color: #ffffff; font-size: 10px; wrap: word-wrap; }
                Text { text: "Windows and macOS releases bundle VLC 3.0.24 and its plugins. Arch installs system libVLC 3 and the full VLC plugin set as package dependencies. Inter is included under the SIL Open Font License 1.1; see the bundled OFL.txt."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                Text { text: root.media-controls-status; color: #ffffff78; font-size: 9px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Music artwork lookup runs automatically when local art is missing. Poster selection is manual; missing movie and TV genres are looked up automatically when a TMDB token is saved."; color: #f46b32; font-size: 10px; font-weight: 650; }
            }
        }

        if root.settings-open: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #000000C8;
            accessible-role: none;
            settings-scope := FocusScope {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(720px, parent.width - 36px);
                height: min(680px, parent.height - 36px);
                forward-focus: add-watched-root-button;
                init => self.focus();
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #211e1b;
                    border-color: #5a392a;
                    border-width: 1px;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 22px;
                        spacing: 8px;
                        HorizontalLayout {
                            Text { text: "Options"; color: #ffffff; font-size: 22px; font-weight: 700; horizontal-stretch: 1; }
                            ArchiveButton {
                                text: "Close";
                                accessible-label: "Close options";
                                clicked => {
                                    root.tmdb-token-input = "";
                                    root.settings-open = false;
                                    root.settings-closed();
                                    movie-keyboard-scope.focus();
                                }
                            }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            content-width: self.width;
                            VerticalLayout {
                                width: parent.width;
                                spacing: 10px;
                        Text { text: "Library folders"; color: #f46b32; font-size: 12px; font-weight: 700; }
                        Text { text: "Folders are scanned on launch and about once a minute. Removing a folder stops future scans; imported items, history, playlists and source files stay in place."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                        if root.watched-roots.length > 0: ListView {
                            height: 138px;
                            accessible-role: list;
                            for watched-root in root.watched-roots: Rectangle {
                                height: 42px;
                                background: #1b1917;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 9px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: watched-root.path; color: #ffffff; font-size: 10px; overflow: elide; accessible-label: watched-root.path; }
                                    }
                                    Text { width: 150px; text: watched-root.status; color: #ffffffB3; font-size: 9px; vertical-alignment: center; overflow: elide; accessible-label: "Folder status: " + watched-root.status; }
                                    ArchiveButton { text: "Remove"; accessible-label: "Stop watching " + watched-root.path + "; keep imported media"; clicked => root.remove-watched-root(watched-root.index); }
                                }
                            }
                        }
                        if root.watched-roots.length == 0: Text { height: 30px; text: "No watched folders. Add a folder to scan it automatically."; color: #ffffffB3; font-size: 10px; vertical-alignment: center; }
                        HorizontalLayout {
                            height: 34px;
                            spacing: 8px;
                            add-watched-root-button := ArchiveButton { text: "Add folder"; primary: true; accessible-label: "Add a watched library folder"; clicked => root.add-watched-root(); }
                            ArchiveButton { text: "Rescan all"; enabled: root.watched-roots.length > 0; accessible-label: "Rescan all watched folders"; clicked => root.rescan-watched-roots(); }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { height: 1px; background: #3b3631; }
                        Text { text: "TMDB movie and TV lookup"; color: #f46b32; font-size: 12px; font-weight: 700; }
                        Text { text: root.tmdb-token-available ? "A TMDB token is available for automatic missing-genre lookup and manual poster search. Add or replace the saved token below, or remove the stored token." : "Add a TMDB read token to enable automatic lookup for missing local movie and TV genres, plus manual poster search."; color: #ffffffB3; font-size: 11px; wrap: word-wrap; }
                        tmdb-token-editor := ArchiveLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.tmdb-token-input;
                            placeholder-text: "TMDB read token";
                            password: true;
                            accessible-label: "TMDB read token. Input is masked and is not prefilled.";
                            edited(text) => root.tmdb-token-input-changed(text);
                            accepted(text) => { root.tmdb-token-input-changed(text); root.save-tmdb-token(); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ArchiveButton { text: "Save token"; primary: true; enabled: root.tmdb-token-input != ""; clicked => root.save-tmdb-token(); }
                            ArchiveButton { text: "Remove stored token"; enabled: root.tmdb-token-available; clicked => root.remove-tmdb-token(); }
                        }
                        Rectangle { height: 1px; background: #3b3631; }
                        Text { text: "Subtitle search"; color: #f46b32; font-size: 12px; font-weight: 700; }
                        Text { text: root.opensubtitles-credentials-available ? "Credentials are stored securely and never shown here. Replace them by entering new values." : "Configure OpenSubtitles to search by title. The API key supports search; a bearer token is also needed to download."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                        ArchiveLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.opensubtitles-api-key-input;
                            placeholder-text: "OpenSubtitles API key";
                            password: true;
                            accessible-label: "OpenSubtitles API key. Input is masked and is not prefilled.";
                        }
                        ArchiveLineEdit {
                            horizontal-stretch: 1;
                            text <=> root.opensubtitles-bearer-token-input;
                            placeholder-text: "Bearer token (optional for search)";
                            password: true;
                            accessible-label: "OpenSubtitles bearer token. Input is masked and is not prefilled.";
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ArchiveButton { text: "Save credentials"; primary: true; enabled: root.opensubtitles-api-key-input != ""; clicked => root.save-opensubtitles-credentials(root.opensubtitles-api-key-input, root.opensubtitles-bearer-token-input); }
                            ArchiveButton { text: "Remove credentials"; enabled: root.opensubtitles-credentials-available; clicked => root.remove-opensubtitles-credentials(); }
                        }
                        if root.opensubtitles-status != "": Text { text: root.opensubtitles-status; color: #ffffffB3; font-size: 10px; wrap: word-wrap; accessible-label: "OpenSubtitles status: " + root.opensubtitles-status; }
                        if root.settings-status != "": Text {
                            text: root.settings-status;
                            color: root.settings-error ? #ff9a85 : #ffffff;
                            font-size: 11px;
                            wrap: word-wrap;
                            accessible-label: "Options status: " + root.settings-status;
                        }
                        Text { text: "When local music artwork is missing, automatic online lookup sends the track title and artist to YouTube. The MusicBrainz fallback may also send the album tag. Native media paths are never sent."; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
        }

        if root.movie-details-open: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #000000B8;
            TouchArea {
                width: parent.width;
                height: parent.height;
                accessible-role: none;
                clicked => { root.close-movie-details(); movie-keyboard-scope.focus(); }
            }
            movie-detail-scope := FocusScope {
                init => self.focus();
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(760px, parent.width - 48px);
                height: min(500px, parent.height - 40px);
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #211e1b;
                    border-color: #5a392a;
                    border-width: 1px;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 14px;
                        HorizontalLayout {
                            Text { text: "FILM DETAILS"; color: #f46b32; font-size: 10px; font-weight: 700; letter-spacing: 1.2px; horizontal-stretch: 1; vertical-alignment: center; }
                            movie-detail-close := ArchiveButton { text: "Close"; clicked => { root.close-movie-details(); movie-keyboard-scope.focus(); } }
                        }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 22px;
                            Rectangle {
                                width: 240px;
                                height: 390px;
                                clip: true;
                                background: #302820;
                                if root.selected-movie-has-artwork: Image { width: parent.width; height: parent.height; source: root.selected-movie-artwork; image-fit: cover; accessible-label: root.selected-movie-title + " poster"; }
                                if !root.selected-movie-has-artwork: Text { text: "No poster"; color: #ffffffB3; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                Text { text: root.selected-movie-title; color: #ffffff; font-size: 27px; font-weight: 720; wrap: word-wrap; }
                                Text { text: root.selected-movie-progress == "" ? "In your library" : root.selected-movie-progress; color: #ffffffB3; font-size: 12px; }
                                Rectangle { height: 1px; background: #51483f; }
                                HorizontalLayout {
                                    spacing: 20px;
                                    VerticalLayout { Text { text: "YEAR"; color: #ffffffB3; font-size: 9px; font-weight: 700; } Text { text: root.selected-movie-year; color: #ffffff; font-size: 12px; } }
                                    VerticalLayout { Text { text: "GENRE"; color: #ffffffB3; font-size: 9px; font-weight: 700; } Text { text: root.selected-movie-genre; color: #ffffff; font-size: 12px; overflow: elide; } }
                                }
                                HorizontalLayout {
                                    spacing: 20px;
                                    VerticalLayout { Text { text: "DURATION"; color: #ffffffB3; font-size: 9px; font-weight: 700; } Text { text: root.selected-movie-duration; color: #ffffff; font-size: 12px; } }
                                    VerticalLayout { Text { text: "FORMAT"; color: #ffffffB3; font-size: 9px; font-weight: 700; } Text { text: root.selected-movie-format; color: #ffffff; font-size: 12px; } }
                                }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    if root.selected-movie-can-resume: ArchiveButton { text: "Resume"; primary: true; clicked => root.play-movie(root.selected-movie-id, true); }
                                    ArchiveButton { text: root.selected-movie-can-resume ? "Start over" : "Play"; primary: !root.selected-movie-can-resume; clicked => root.play-movie(root.selected-movie-id, false); }
                                    ArchiveButton { text: "Choose poster"; enabled: root.tmdb-token-available; clicked => root.find-online-artwork(); }
                                    if root.selected-movie-local: ArchiveButton { text: "Relink file"; accessible-label: "Choose a replacement file for this movie"; clicked => root.relink-media(root.selected-movie-id); }
                                    Rectangle { horizontal-stretch: 1; }
                                    ArchiveButton { text: root.selected-movie-saved ? "Remove from My List" : "Add to My List"; style: "chip"; primary: root.selected-movie-saved; clicked => root.toggle-saved-movie(root.selected-movie-id); }
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.tmdb-picker-open: Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #000000C9;
            TouchArea {
                width: parent.width;
                height: parent.height;
                accessible-role: none;
                clicked => root.close-tmdb-picker();
            }
            tmdb-picker-scope := FocusScope {
                init => self.focus();
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(720px, parent.width - 40px);
                height: min(650px, parent.height - 40px);
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #211e1b;
                    border-color: #5a392a;
                    border-width: 1px;
                    border-radius: 10px;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        HorizontalLayout {
                            Text { text: "CHOOSE A TMDB POSTER"; color: #f46b32; font-size: 11px; font-weight: 700; letter-spacing: 1px; horizontal-stretch: 1; vertical-alignment: center; }
                            ArchiveButton { text: "Close"; clicked => root.close-tmdb-picker(); }
                        }
                        if root.tmdb-picker-status != "": Text {
                            height: 22px;
                            text: root.tmdb-picker-status;
                            color: #ffffffB3;
                            font-size: 11px;
                            wrap: word-wrap;
                            accessible-label: "TMDB artwork search status: " + root.tmdb-picker-status;
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            VerticalLayout {
                                spacing: 8px;
                                for candidate in root.tmdb-candidates: Rectangle {
                                    height: 112px;
                                    background: #302820;
                                    border-radius: 5px;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 64px;
                                            height: 96px;
                                            background: #211e1b;
                                            if candidate.has-artwork: Image { width: parent.width; height: parent.height; source: candidate.artwork; image-fit: cover; accessible-label: candidate.title + " poster preview"; }
                                            if !candidate.has-artwork: Text { text: "No poster"; color: #ffffffB3; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 5px;
                                            Text { text: candidate.title + (candidate.year == "" ? "" : " (" + candidate.year + ")"); color: #ffffff; font-size: 14px; font-weight: 650; wrap: word-wrap; }
                                            Text { text: candidate.genre == "" ? "Genre unavailable" : candidate.genre; color: #ffffffB3; font-size: 10px; wrap: word-wrap; }
                                            Rectangle { vertical-stretch: 1; }
                                            ArchiveButton {
                                                text: "Use this poster";
                                                primary: true;
                                                enabled: candidate.has-artwork && !root.tmdb-picker-busy;
                                                accessible-label: "Use the poster for " + candidate.title;
                                                clicked => root.select-tmdb-candidate(candidate.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component PictureInPictureWindow inherits Window {
    title: "Première · Picture in picture";
    preferred-width: 480px;
    preferred-height: 270px;
    min-width: 280px;
    min-height: 158px;
    always-on-top: true;
    background: #080808;
    default-font-family: "Inter";

    in property <image> video-frame;
    in property <bool> has-video-frame: false;
    in property <string> current-title: "Video";
    in property <string> player-state: "Ready";
    in property <bool> can-toggle-pause: false;
    in property <bool> is-paused: false;

    callback toggle-pause();
    callback return-to-player();
    callback close-picture-in-picture();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #080808;
        clip: true;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.video-frame;
            image-fit: contain;
        }
        if !root.has-video-frame: Text {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            height: parent.height - 32px;
            text: root.player-state == "Playback error" ? "Playback error" : "Waiting for a video frame…";
            color: #ffffffB3;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        Rectangle {
            x: 0px;
            y: parent.height - 54px;
            width: parent.width;
            height: 54px;
            background: #141312D8;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: root.current-title;
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 650;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    accessible-label: root.current-title;
                }
                ArchiveButton {
                    width: 42px;
                    height: 38px;
                    style: "icon";
                    primary: true;
                    text: root.player-state == "Finished" ? "↻" : root.is-paused || root.player-state == "Ready" ? "▶" : "Ⅱ";
                    accessible-label: root.player-state == "Finished" ? "Replay video" : root.is-paused || root.player-state == "Ready" ? "Play video" : "Pause video";
                    enabled: root.can-toggle-pause;
                    clicked => root.toggle-pause();
                }
                ArchiveButton {
                    text: "Return";
                    accessible-label: "Return to the main video player";
                    clicked => root.return-to-player();
                }
                ArchiveButton {
                    width: 34px;
                    height: 34px;
                    style: "icon";
                    text: "×";
                    accessible-label: "Close picture-in-picture window";
                    clicked => root.close-picture-in-picture();
                }
            }
        }
    }
}
